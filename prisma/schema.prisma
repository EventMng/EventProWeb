generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SYSTEM_ADMIN
  ORG_ADMIN
  ORGANIZER
  FRONTMAN
}

model Organization {
  id            String         @id @default(uuid())
  name          String
  createdAt     DateTime       @default(now()) @map("created_at")
  users         User[]
  events        Event[]
  participants  Participant[]

  @@map("organizations")
}

model User {
  id                  String   @id @default(uuid())
  organizationId      String   @map("organization_id")
  organization        Organization @relation(fields: [organizationId], references: [id])
  fullName            String   @map("full_name")
  email               String   @unique
  passwordHash        String   @map("password_hash")
  role                UserRole
  isTemporaryPassword Boolean  @default(false) @map("is_temporary_password")
  createdAt           DateTime @default(now()) @map("created_at")

  createdEvents       Event[]            @relation("EventCreatedBy")
  createdParticipants Participant[]      @relation("ParticipantCreatedBy")
  frontmanAssignments EventFrontman[]
  markedRegistrations EventRegistration[] @relation("MarkedBy")

  @@map("users")
}

model Event {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdBy      String   @map("created_by")
  creator        User     @relation("EventCreatedBy", fields: [createdBy], references: [id])
  name           String
  location       String?
  eventDate      DateTime @map("event_date")
  createdAt      DateTime @default(now()) @map("created_at")

  frontmen      EventFrontman[]
  registrations EventRegistration[]

  @@map("events")
}

model EventFrontman {
  eventId    String   @map("event_id")
  userId     String   @map("user_id")
  assignedAt DateTime @default(now()) @map("assigned_at")

  event Event @relation(fields: [eventId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@id([eventId, userId])
  @@map("event_frontmen")
}

model Participant {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id])
  fullName       String   @map("full_name")
  email          String
  imageUrl       String?  @map("image_url")
  createdById    String?  @map("created_by_id")
  creator        User?    @relation("ParticipantCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime @default(now()) @map("created_at")

  registrations EventRegistration[]

  @@map("participants")
}

model EventRegistration {
  id                String    @id @default(uuid())
  eventId           String    @map("event_id")
  event             Event     @relation(fields: [eventId], references: [id])
  participantId     String    @map("participant_id")
  participant       Participant @relation(fields: [participantId], references: [id])
  ticketType        String    @default("General") @map("ticket_type")
  qrToken           String    @unique @map("qr_token")
  invitationSentAt  DateTime? @map("invitation_sent_at")
  attended          Boolean   @default(false)
  attendedAt        DateTime? @map("attended_at")
  markedBy          String?   @map("marked_by")
  marker            User?     @relation("MarkedBy", fields: [markedBy], references: [id])

  @@unique([eventId, participantId])
  @@map("event_registrations")
}
